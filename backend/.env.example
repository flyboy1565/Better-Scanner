# FastAPI Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
DEBUG=True

# Scanner Configuration
TARGET_DIR=./scans
RAW_SCAN_PATH=raw_scan_temp.jpg
# Resolution (DPI) for scans. 600 = max optical quality; may take longer over eSCL.
SCAN_RESOLUTION=600

# SCANNER_IPS: Space-separated list of scanner IPs (for WSL2 mDNS workaround)
# SCANNER_NAMES: Optional space-separated friendly names, 1:1 with SCANNER_IPS
# Example:
#   SCANNER_IPS=192.168.0.55 192.168.0.25
#   SCANNER_NAMES="ET-2800 WF-4720"

# Save Mode: Controls where scanned photos go
#   "local"       - Save to disk only (TARGET_DIR)
#   "immich_only" - Upload to Immich only (no local copy)
#   "both"        - Save to disk AND upload to Immich
SAVE_MODE=both

# Immich Configuration
IMMICH_SERVER_URL=https://photos.duckdns.org
IMMICH_API_KEY=your_api_key_here
IMMICH_ENABLED=True

# CORS Settings
CORS_ORIGINS=["http://localhost:3000", "http://localhost"]
